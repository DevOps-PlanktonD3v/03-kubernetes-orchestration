# ============================================================
# .env.example - Template Environment Variables
#
# File ini adalah TEMPLATE — salin ke .env sebelum menjalankan:
#   cp .env.example .env
#   php artisan key:generate
#
# Di Kubernetes, env var di-inject melalui ConfigMap dan Secret,
# bukan dari file .env. File .env digunakan saat development lokal.
#
# JANGAN pernah commit file .env ke Git!
# ============================================================

# Nama aplikasi
APP_NAME="Laravel K8s Demo"

# Environment: local | staging | production
APP_ENV=production

# Kunci enkripsi — generate dengan: php artisan key:generate
# Di Kubernetes, inject sebagai Secret
APP_KEY=

# Mode debug — WAJIB false di production
APP_DEBUG=false

# URL publik aplikasi
APP_URL=http://localhost

# Timezone aplikasi
APP_TIMEZONE=UTC

# -----------------------------------------------
# Logging
# Gunakan LOG_CHANNEL=stderr untuk Kubernetes agar
# log bisa dibaca dengan: kubectl logs <pod-name>
# -----------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=info

# -----------------------------------------------
# Database (tidak digunakan di lab ini)
# -----------------------------------------------
DB_CONNECTION=sqlite

# -----------------------------------------------
# Cache & Session
# Untuk multi-replica di Kubernetes, ganti ke redis
# -----------------------------------------------
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# -----------------------------------------------
# Queue
# -----------------------------------------------
QUEUE_CONNECTION=sync
